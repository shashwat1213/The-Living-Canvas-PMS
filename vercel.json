{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run db:generate -w backend && npm run build -w backend && npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{backend/dist/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs" },
    { "source": "/health", "destination": "/api/index.mjs" },
    { "source": "/((?!assets/|favicon.svg|icons.svg|robots.txt).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/drain-jobs", "schedule": "0 3 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
