// The Living Canvas PMS — core database schema
// Foundation scope: organizations, staff users, properties, rooms.
// Phase 1 scope (2026-08-19, see DECISIONS.md): sessions, permission-based
// RBAC, property-level access grants — auth/tenancy/authorization plumbing.
// Still out of scope (future phases): bookings, OTA integrations, reviews,
// payments, marketing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant of the SaaS platform: one hospitality company that owns
/// one or more properties. Everything else is scoped under an Organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  properties Property[]
  roles      Role[]
  auditLogs  AuditLog[]
  guests     Guest[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

/// A staff member who can log in and operate the PMS on behalf of
/// an Organization. `role` is a coarse, UI-facing preset — the
/// authorization decision itself is made from resolved permissions via
/// UserRoleAssignment -> Role -> RolePermission (see Phase 1 decisions in
/// DECISIONS.md), not from this enum directly.
model User {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  role             UserRole  @default(STAFF)
  isActive         Boolean   @default(true) @map("is_active")
  /// Token-revocation watermark (see DECISIONS.md, "token-revocation
  /// watermark"): an already-issued JWT access token with an `iat` before
  /// this timestamp is rejected by `authenticate`, regardless of its own
  /// expiry. Null means "no floor" — the default, no-op state for every
  /// user who has never been deactivated; nullable specifically so this
  /// column needs no backfill and changes nothing for existing users on
  /// migration day.
  tokensValidAfter DateTime? @map("tokens_valid_after")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions          Session[]
  roleAssignments   UserRoleAssignment[]
  propertyAccess    PropertyAccess[]
  auditEvents       AuditLog[]
  housekeepingTasks HousekeepingTask[]   @relation("HousekeepingAssignee")

  @@index([organizationId])
  @@map("users")
}

/// A refresh session backing the JWT access token (Phase 1 decision #1,
/// see DECISIONS.md): the access token is short-lived and stateless, but
/// the refresh token is a real row here so a session can be revoked
/// immediately (e.g. staff offboarding) rather than waiting out an
/// expiry. Only a hash of the refresh token is stored, never the token
/// itself.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// The global permission catalog (Phase 1 decision #2, see DECISIONS.md).
/// Deliberately NOT scoped under Organization — a permission key like
/// "properties:update" is a platform-defined capability, the same across
/// every tenant, not a piece of any one organization's business data.
/// The source of truth for which keys exist is
/// `backend/src/platform/rbac/permissions.ts`; this table exists so
/// RolePermission can have a real foreign key and so a future admin UI
/// can list permissions without hardcoding them.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// An organization-scoped role. Every organization gets its own copy of
/// the four built-in presets (OWNER/ADMIN/MANAGER/STAFF, `isSystem =
/// true`) seeded at organization-creation time, matching `User.role`'s
/// enum values — this is what lets a future custom-role builder extend
/// the same schema without a breaking migration, while Phase 1 itself
/// only ever creates the four system presets.
model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Join table: which permissions a Role grants.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Join table: which roles a User holds. Named `UserRoleAssignment`
/// (rather than `UserRole`) because `UserRole` is already the enum on
/// `User.role`.
model UserRoleAssignment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_role_assignments")
}

/// Explicit grant of a User onto a Property. OWNER/ADMIN role-holders
/// reach every property in their organization implicitly (checked in
/// application code, not via a row here); MANAGER/STAFF need an explicit
/// row per property they may access. Absence of a row is the default
/// (no access) — this table only ever grants, never restricts.
model PropertyAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("property_access")
}

/// Who performed an audited action. `USER` is a signed-in staff member.
/// `SYSTEM` is the platform acting on its own (scheduled jobs, automated
/// offboarding). `AGENT` is an AI agent acting through the application's
/// own services — present from the start so adding one later is a value
/// on an existing column rather than a migration on a live audit table.
enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

/// Immutable record of a consequential action taken within an
/// Organization. Written by `src/platform/audit/recorder.ts` from inside
/// the service that performed the action, never by a route or a client.
///
/// Deliberately generic rather than staff-specific: `entityType` +
/// `entityId` name the target polymorphically and `action` is a
/// namespaced string ("staff.role_changed"), NOT a database enum — so
/// properties, units, leases, maintenance, payments and agent actions all
/// reuse this table without a schema change. The catalog of valid actions
/// lives in `src/platform/audit/actions.ts`, where adding one costs a
/// constant instead of a migration on a table that only grows.
///
/// Rows are append-only by convention: there is no update or delete path
/// in application code. The only deletion is the Organization cascade,
/// which is tenant offboarding — retaining a deleted tenant's audit trail
/// would be the leak, not the safeguard.
model AuditLog {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  actorType      AuditActorType @default(USER) @map("actor_type")
  /// Null once the acting user is gone (`SetNull`, not cascade — an audit
  /// trail that disappears with its subject is not an audit trail).
  actorUserId    String?        @map("actor_user_id")
  /// The actor's email captured at write time. Denormalized on purpose:
  /// an audit record has to stay meaningful on its own, including after
  /// the account it refers to no longer exists.
  actorEmail     String?        @map("actor_email")
  /// Namespaced "<module>.<event>" — see `platform/audit/actions.ts`.
  action         String
  /// The kind of thing acted on ("staff", later "property", "lease", …).
  entityType     String         @map("entity_type")
  entityId       String         @map("entity_id")
  /// Structured, action-specific detail (e.g. `{ from, to }` for a role
  /// change). Never contains credentials — see the recorder.
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Every index leads with `organizationId`: no query reaches this table
  /// without a tenant filter, so a tenant-first index is the one that
  /// actually gets used.
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId])
  @@map("audit_logs")
}

/// A single physical venue (hotel, guesthouse, etc.) belonging to an Organization.
model Property {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timezone       String   @default("UTC")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  roomTypes      RoomType[]
  propertyAccess PropertyAccess[]
  reservations   Reservation[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("properties")
}

/// A category of room within a Property — "Deluxe King", "Standard Twin".
///
/// Scoped to a single Property rather than to the Organization: two
/// hotels in the same group name and price their rooms independently, and
/// a shared catalogue would force one property's rename onto the other.
/// Tenancy therefore reaches this model transitively through `Property`,
/// exactly as `Room` does — there is no `organizationId` column here, and
/// `platform/tenancy/scoped-prisma.ts` scopes it through the relation.
///
/// Deliberately thin. Occupancy lives on `Room.capacity` today; putting a
/// second copy here with no code to reconcile the two would create a
/// silent source-of-truth conflict. Rate plans, availability and
/// reservations attach to this model in later slices — none of them are
/// modelled yet.
model RoomType {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  name        String
  /// Short operational code ("DLXK"). Optional: the backfill has only the
  /// legacy free-text name to work from and must not invent one.
  code        String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  ratePlans    RatePlan[]
  reservations Reservation[]

  @@unique([propertyId, name])
  @@unique([propertyId, code])
  @@index([propertyId])
  @@map("room_types")
}

/// A sellable rate for a RoomType — "Best Available Rate", "Non-Refundable",
/// "Advance Purchase". The model every commercial PMS uses (Mews, Cloudbeds,
/// Stayntouch): what a room type costs is not one number but a set of plans,
/// each with its own price per date and its own cancellation policy.
///
/// Scoped to a RoomType (and thus transitively to a Property, then an
/// Organization), never to the Organization directly: two hotels in one group
/// price independently, and a plan belongs to exactly one sellable type. The
/// per-date price lives on `RatePlanRate` rather than a single column here,
/// because a hotel's price changes by season, weekend and demand — a flat
/// nightly rate is the thing real revenue management exists to avoid.
model RatePlan {
  id           String   @id @default(uuid())
  roomTypeId   String   @map("room_type_id")
  name         String
  /// Short operational code ("BAR", "NR"). Optional, upper-cased on input,
  /// unique per room type — same treatment as RoomType.code.
  code         String?
  description  String?
  /// Whether a booking on this plan can be cancelled for a refund. The one
  /// policy bit every PMS models from day one (BAR is refundable,
  /// "Non-Refundable"/"Advance Purchase" are not); richer cancellation rules
  /// (deadlines, penalties) are a later slice.
  isRefundable Boolean  @default(true) @map("is_refundable")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roomType     RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  rates        RatePlanRate[]
  reservations Reservation[]

  @@unique([roomTypeId, name])
  @@unique([roomTypeId, code])
  @@index([roomTypeId])
  @@map("rate_plans")
}

/// The price of one RatePlan on one calendar date, in INR minor units
/// (paise). One row per (plan, date): this is the room-night pricing grid a
/// revenue manager edits, and storing it per-date rather than as a rule is
/// what makes an arbitrary seasonal calendar representable without a rules
/// engine.
///
/// `date` is date-only (a stay night, not an instant) — consistent with the
/// project's date-only stay-date decision. Absence of a row for a date means
/// "no price set / not sellable on this plan that night", which a booking
/// treats as unavailable rather than free.
model RatePlanRate {
  id          String   @id @default(uuid())
  ratePlanId  String   @map("rate_plan_id")
  /// Stay night this price applies to. Stored at 00:00:00 UTC (date-only).
  date        DateTime @db.Date
  /// Price in INR minor units (paise). Integer on purpose: money is never a
  /// float. INR-only per the initial-release decision — no currency column.
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@index([ratePlanId, date])
  @@map("rate_plan_rates")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// The housekeeping condition of a room — its physical cleanliness, which is
/// a DIFFERENT axis from `RoomStatus` (its inventory/service state). Every
/// commercial PMS (Cloudbeds, Mews, Stayntouch) keeps these separate: a DIRTY
/// room is still sellable and bookable; only `RoomStatus` (out of service /
/// maintenance) removes a room from inventory. Housekeeping condition governs
/// whether a room is *ready to hand a guest the key*, not whether it can be
/// sold.
///
/// The daily flow: a departure leaves the room DIRTY; an attendant works it to
/// CLEANING then CLEAN; a supervisor inspection promotes CLEAN → INSPECTED
/// (ready). Properties that do not run an inspection step simply treat CLEAN as
/// ready and never use INSPECTED.
enum HousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

/// A bookable unit (room) within a Property. `status` is the room's
/// inventory/service state (sellable, inactive, out for maintenance);
/// `housekeepingStatus` is the orthogonal physical-cleanliness axis the
/// housekeeping module owns — see `HousekeepingStatus`.
model Room {
  id                 String             @id @default(uuid())
  propertyId         String             @map("property_id")
  name               String
  /// The room's category, drawn from this property's RoomType catalogue.
  /// Required: a room is always a bookable unit of some sellable type —
  /// the model Mews/Cloudbeds/Stayntouch all use — and rates and
  /// availability attach to the type, so an untyped room could never be
  /// sold. The legacy free-text `room_type` column this replaced was
  /// backfilled into `room_types` and dropped in migration
  /// `20260902000200_rooms_catalogue_only`.
  roomTypeId         String             @map("room_type_id")
  floor              String?
  capacity           Int                @default(1)
  status             RoomStatus         @default(ACTIVE)
  /// Physical-cleanliness condition (see `HousekeepingStatus`). Defaults to
  /// INSPECTED so a freshly created room is immediately ready to sell — a new
  /// room has not been slept in. Distinct from `status`: this never blocks a
  /// booking, it governs readiness to hand over the key.
  housekeepingStatus HousekeepingStatus @default(INSPECTED) @map("housekeeping_status")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: `roomTypeId` is now required, so a type still
  /// assigned to rooms must not be deletable out from under them. This is
  /// the database backstop for the 409 the room-types service already
  /// returns proactively (see `modules/room-types/service.ts`).
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@index([roomTypeId])
  @@map("rooms")
}

/// A person who stays (or has booked to stay) at one of an Organization's
/// properties. Scoped to the Organization, not a single Property: a guest is
/// a relationship the hospitality company owns — the same person can stay at
/// several of its hotels, and their history should follow them. Tenancy is a
/// real `organization_id` column, like `User` and `Property`.
///
/// Deliberately thin for the booking-core slice: enough to identify and
/// contact a guest. A richer guest profile (loyalty, preferences, documents,
/// GDPR consent) is a later module and attaches here without reshaping this.
model Guest {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  /// Contact details are optional: a walk-in booked at the desk may give a
  /// name and nothing else, and a PMS must still be able to house them.
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([organizationId])
  // Email is not globally unique — two organizations may each know the same
  // person — but a partial guard against duplicate profiles within one
  // organization is worth having. Enforced in application code rather than a
  // DB constraint because email is nullable and duplicates from separate
  // walk-ins are a legitimate reality, not an error to reject outright.
  @@index([organizationId, email])
  @@map("guests")
}

/// The lifecycle of a reservation.
///
/// This slice implements the booking half — a reservation is created
/// CONFIRMED, and can move to CANCELLED (guest/hotel cancels) or NO_SHOW
/// (never arrived). CHECKED_IN and COMPLETED belong to the check-in/out
/// slice and are present in the enum from the start so arrivals and
/// departures are a status transition, not a later migration on a live
/// bookings table.
enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// A booking: a guest, a room type, a rate plan, and a stay window. The
/// central transactional record of the PMS — everything downstream (folios,
/// housekeeping, reports) hangs off it.
///
/// ## What it references, and why those FKs are RESTRICT
///
/// A reservation books a *room type*, not a specific room — the industry
/// model (Mews/Cloudbeds/Stayntouch): the guest buys "a Deluxe King", and
/// which physical room they get is assigned at or before check-in (a later
/// slice). `roomId` is therefore nullable and unset here.
///
/// `roomTypeId`, `ratePlanId` and `guestId` are `onDelete: Restrict`: a room
/// type, rate plan or guest that a reservation refers to must not vanish out
/// from under it. This is the database backstop for the delete-guards the
/// services enforce proactively — the same pattern `Room → RoomType` already
/// uses. The `property` cascade is the deliberate exception: deleting a whole
/// property is tenant-level teardown, and its bookings go with it.
///
/// ## Money is snapshotted, not recomputed
///
/// `totalAmountMinor` is the price agreed at booking time, and the per-night
/// breakdown lives in `ReservationNight`. A later change to a `RatePlanRate`
/// must never silently re-price a booking a guest already holds — so the
/// price is copied onto the reservation when it is made, not read back
/// through the rate plan. Stored in INR minor units (paise), integer.
model Reservation {
  id               String            @id @default(uuid())
  propertyId       String            @map("property_id")
  roomTypeId       String            @map("room_type_id")
  ratePlanId       String            @map("rate_plan_id")
  guestId          String            @map("guest_id")
  /// The specific room, once assigned. Null until room assignment (a
  /// check-in-slice concern) — a booking is for a type, not a room.
  roomId           String?           @map("room_id")
  /// Human-friendly booking reference (e.g. "LC-3F9K2A"), unique per
  /// property. Shown to staff and guests instead of the UUID.
  reference        String
  status           ReservationStatus @default(CONFIRMED)
  /// Arrival date (date-only, the first stay night). Inclusive.
  checkIn          DateTime          @map("check_in") @db.Date
  /// Departure date (date-only). Exclusive — the guest does not stay this
  /// night, matching how every PMS counts nights: nights = checkOut - checkIn.
  checkOut         DateTime          @map("check_out") @db.Date
  adults           Int               @default(1)
  children         Int               @default(0)
  /// Total price agreed at booking, in INR paise. Sum of the nights below.
  totalAmountMinor Int               @map("total_amount_minor")
  notes            String?
  /// When and why a reservation left the active state — captured so a
  /// cancelled/no-show booking explains itself without a separate lookup.
  cancelledAt      DateTime?         @map("cancelled_at")
  cancelReason     String?           @map("cancel_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  ratePlan RatePlan           @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  guest    Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room     Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  nights   ReservationNight[]
  folio    Folio?

  @@unique([propertyId, reference])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([ratePlanId])
  @@index([guestId])
  // The query availability actually runs: "reservations at this property, of
  // this type, overlapping these dates". A composite index on the columns
  // that filter makes the overlap count cheap.
  @@index([propertyId, roomTypeId, checkIn, checkOut])
  @@map("reservations")
}

/// One night of a reservation, with the price locked in at booking time.
///
/// This is the snapshot that makes `Reservation.totalAmountMinor`
/// trustworthy: the price of each night is copied from the rate plan when the
/// booking is made, so a later repricing of the calendar leaves existing
/// bookings untouched. It is also what a folio will bill from, and what a
/// nightly revenue report will sum — the authoritative per-night ledger of
/// what was actually sold.
model ReservationNight {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  /// The stay night (date-only). One row per night in [checkIn, checkOut).
  date          DateTime @db.Date
  /// Price for this night in INR paise, as agreed at booking time.
  amountMinor   Int      @map("amount_minor")
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, date])
  @@index([reservationId])
  @@map("reservation_nights")
}

/// The guest bill for a reservation — one folio per booking (1:1). A folio is
/// the running account of what the guest owes (charges) against what they have
/// paid (payments); its balance is charges minus payments.
///
/// Money model: every amount is INR minor units (paise), integer — never a
/// float, matching the rest of the system. There is no currency column
/// (INR-only per the initial-release decision). The folio does NOT store a
/// cached balance; balance is derived from its charges and payments so it can
/// never drift out of sync with the rows that justify it.
///
/// Tenancy reaches the folio transitively through `reservation → property`,
/// exactly as ReservationNight does. Deleting a reservation cascades its folio
/// (and the folio's charges/payments) — the bill has no meaning without the
/// booking it belongs to.
model Folio {
  id            String      @id @default(uuid())
  reservationId String      @unique @map("reservation_id")
  status        FolioStatus @default(OPEN)
  /// When the folio was settled and closed (balance zero, no further posting).
  closedAt      DateTime?   @map("closed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  charges     FolioCharge[]
  payments    Payment[]

  @@index([reservationId])
  @@map("folios")
}

/// A single line item on a folio — a room charge auto-posted from the
/// reservation's nightly total when the folio opens, or a manually added
/// extra (minibar, late checkout, damage). `amountMinor` is positive for a
/// charge the guest owes; a correction is a separate negative line rather than
/// an edit, so the ledger is append-only and auditable.
model FolioCharge {
  id          String   @id @default(uuid())
  folioId     String   @map("folio_id")
  description String
  /// Charge amount in INR paise. Positive owes the guest; negative is a
  /// correction/discount line.
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@map("folio_charges")
}

/// A payment recorded against a folio. This is a manual-entry model: the front
/// desk records that a payment was taken (cash, card, UPI, bank transfer),
/// with an optional external reference — it is NOT a live payment-gateway
/// integration and holds no gateway credentials. `amountMinor` is the amount
/// received in INR paise (positive); a refund is a separate negative row so
/// the payment history stays append-only.
model Payment {
  id          String        @id @default(uuid())
  folioId     String        @map("folio_id")
  method      PaymentMethod
  /// Amount received in INR paise (positive); a refund is a negative row.
  amountMinor Int           @map("amount_minor")
  /// Optional external reference — a card auth code, UPI transaction id, or
  /// cheque number. Free text; never a stored credential.
  reference   String?
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@map("payments")
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

/// The lifecycle of a housekeeping task.
enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

/// The kind of clean a task represents — the distinction housekeeping
/// supervisors actually schedule around. A DEPARTURE clean turns a room over
/// after a checkout (the heavy, full clean); a STAYOVER is the lighter daily
/// service for a guest still in-house; TURNDOWN is the evening service; OTHER
/// covers deep cleans and ad-hoc work.
enum HousekeepingTaskType {
  DEPARTURE
  STAYOVER
  TURNDOWN
  OTHER
}

/// A unit of housekeeping work on a room — the task board a housekeeping
/// supervisor runs the day from. Created automatically when a departure leaves
/// a room to be turned over (see the check-out flow in
/// `modules/reservations/service.ts`), or manually for a stayover / deep clean.
///
/// A task optionally names the staff member it is assigned to; completing a
/// DONE task is what a supervisor uses to drive the room's
/// `Room.housekeepingStatus` forward. Tenancy reaches this model transitively
/// through `room → property → organizationId`, exactly as ReservationNight /
/// Folio do — there is no `organizationId` column here.
model HousekeepingTask {
  id           String                 @id @default(uuid())
  roomId       String                 @map("room_id")
  type         HousekeepingTaskType   @default(DEPARTURE)
  status       HousekeepingTaskStatus @default(PENDING)
  /// The staff member this task is assigned to, if any. SetNull (not Cascade):
  /// deactivating/removing a user must not delete the history of work assigned
  /// to them — the task survives as an unassigned record.
  assignedToId String?                @map("assigned_to_id")
  notes        String?
  /// When the task moved to DONE. Null until completed.
  completedAt  DateTime?              @map("completed_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("HousekeepingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([assignedToId])
  @@index([status])
  @@map("housekeeping_tasks")
}
