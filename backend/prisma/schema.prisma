// The Living Canvas PMS — core database schema
// Scope for this task: organizations, staff users, properties, rooms.
// Out of scope (future tasks): bookings, OTA integrations, reviews, payments, marketing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant of the SaaS platform: one hospitality company that owns
/// one or more properties. Everything else is scoped under an Organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  properties Property[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

/// A staff member who can log in and operate the PMS on behalf of
/// an Organization. Authentication itself is implemented in a later task;
/// passwordHash is nullable until then.
model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String?  @map("password_hash")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

/// A single physical venue (hotel, guesthouse, etc.) belonging to an Organization.
model Property {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timezone       String   @default("UTC")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("properties")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// A bookable unit (room) within a Property. This models the room's
/// operational status only — booking/occupancy state is a future module.
model Room {
  id         String     @id @default(uuid())
  propertyId String     @map("property_id")
  name       String
  roomType   String      @map("room_type")
  floor      String?
  capacity   Int         @default(1)
  status     RoomStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("rooms")
}
