// The Living Canvas PMS — core database schema
// Foundation scope: organizations, staff users, properties, rooms.
// Phase 1 scope (2026-08-19, see DECISIONS.md): sessions, permission-based
// RBAC, property-level access grants — auth/tenancy/authorization plumbing.
// Still out of scope (future phases): bookings, OTA integrations, reviews,
// payments, marketing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant of the SaaS platform: one hospitality company that owns
/// one or more properties. Everything else is scoped under an Organization.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  properties Property[]
  roles      Role[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

/// A staff member who can log in and operate the PMS on behalf of
/// an Organization. `role` is a coarse, UI-facing preset — the
/// authorization decision itself is made from resolved permissions via
/// UserRoleAssignment -> Role -> RolePermission (see Phase 1 decisions in
/// DECISIONS.md), not from this enum directly.
model User {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  role             UserRole  @default(STAFF)
  isActive         Boolean   @default(true) @map("is_active")
  /// Token-revocation watermark (see DECISIONS.md, "token-revocation
  /// watermark"): an already-issued JWT access token with an `iat` before
  /// this timestamp is rejected by `authenticate`, regardless of its own
  /// expiry. Null means "no floor" — the default, no-op state for every
  /// user who has never been deactivated; nullable specifically so this
  /// column needs no backfill and changes nothing for existing users on
  /// migration day.
  tokensValidAfter DateTime? @map("tokens_valid_after")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions        Session[]
  roleAssignments UserRoleAssignment[]
  propertyAccess  PropertyAccess[]
  auditEvents     AuditLog[]

  @@index([organizationId])
  @@map("users")
}

/// A refresh session backing the JWT access token (Phase 1 decision #1,
/// see DECISIONS.md): the access token is short-lived and stateless, but
/// the refresh token is a real row here so a session can be revoked
/// immediately (e.g. staff offboarding) rather than waiting out an
/// expiry. Only a hash of the refresh token is stored, never the token
/// itself.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// The global permission catalog (Phase 1 decision #2, see DECISIONS.md).
/// Deliberately NOT scoped under Organization — a permission key like
/// "properties:update" is a platform-defined capability, the same across
/// every tenant, not a piece of any one organization's business data.
/// The source of truth for which keys exist is
/// `backend/src/platform/rbac/permissions.ts`; this table exists so
/// RolePermission can have a real foreign key and so a future admin UI
/// can list permissions without hardcoding them.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// An organization-scoped role. Every organization gets its own copy of
/// the four built-in presets (OWNER/ADMIN/MANAGER/STAFF, `isSystem =
/// true`) seeded at organization-creation time, matching `User.role`'s
/// enum values — this is what lets a future custom-role builder extend
/// the same schema without a breaking migration, while Phase 1 itself
/// only ever creates the four system presets.
model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Join table: which permissions a Role grants.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Join table: which roles a User holds. Named `UserRoleAssignment`
/// (rather than `UserRole`) because `UserRole` is already the enum on
/// `User.role`.
model UserRoleAssignment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_role_assignments")
}

/// Explicit grant of a User onto a Property. OWNER/ADMIN role-holders
/// reach every property in their organization implicitly (checked in
/// application code, not via a row here); MANAGER/STAFF need an explicit
/// row per property they may access. Absence of a row is the default
/// (no access) — this table only ever grants, never restricts.
model PropertyAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("property_access")
}

/// Who performed an audited action. `USER` is a signed-in staff member.
/// `SYSTEM` is the platform acting on its own (scheduled jobs, automated
/// offboarding). `AGENT` is an AI agent acting through the application's
/// own services — present from the start so adding one later is a value
/// on an existing column rather than a migration on a live audit table.
enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

/// Immutable record of a consequential action taken within an
/// Organization. Written by `src/platform/audit/recorder.ts` from inside
/// the service that performed the action, never by a route or a client.
///
/// Deliberately generic rather than staff-specific: `entityType` +
/// `entityId` name the target polymorphically and `action` is a
/// namespaced string ("staff.role_changed"), NOT a database enum — so
/// properties, units, leases, maintenance, payments and agent actions all
/// reuse this table without a schema change. The catalog of valid actions
/// lives in `src/platform/audit/actions.ts`, where adding one costs a
/// constant instead of a migration on a table that only grows.
///
/// Rows are append-only by convention: there is no update or delete path
/// in application code. The only deletion is the Organization cascade,
/// which is tenant offboarding — retaining a deleted tenant's audit trail
/// would be the leak, not the safeguard.
model AuditLog {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  actorType      AuditActorType @default(USER) @map("actor_type")
  /// Null once the acting user is gone (`SetNull`, not cascade — an audit
  /// trail that disappears with its subject is not an audit trail).
  actorUserId    String?        @map("actor_user_id")
  /// The actor's email captured at write time. Denormalized on purpose:
  /// an audit record has to stay meaningful on its own, including after
  /// the account it refers to no longer exists.
  actorEmail     String?        @map("actor_email")
  /// Namespaced "<module>.<event>" — see `platform/audit/actions.ts`.
  action         String
  /// The kind of thing acted on ("staff", later "property", "lease", …).
  entityType     String         @map("entity_type")
  entityId       String         @map("entity_id")
  /// Structured, action-specific detail (e.g. `{ from, to }` for a role
  /// change). Never contains credentials — see the recorder.
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Every index leads with `organizationId`: no query reaches this table
  /// without a tenant filter, so a tenant-first index is the one that
  /// actually gets used.
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId])
  @@map("audit_logs")
}

/// A single physical venue (hotel, guesthouse, etc.) belonging to an Organization.
model Property {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timezone       String   @default("UTC")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  country        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms          Room[]
  roomTypes      RoomType[]
  propertyAccess PropertyAccess[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("properties")
}

/// A category of room within a Property — "Deluxe King", "Standard Twin".
///
/// Scoped to a single Property rather than to the Organization: two
/// hotels in the same group name and price their rooms independently, and
/// a shared catalogue would force one property's rename onto the other.
/// Tenancy therefore reaches this model transitively through `Property`,
/// exactly as `Room` does — there is no `organizationId` column here, and
/// `platform/tenancy/scoped-prisma.ts` scopes it through the relation.
///
/// Deliberately thin. Occupancy lives on `Room.capacity` today; putting a
/// second copy here with no code to reconcile the two would create a
/// silent source-of-truth conflict. Rate plans, availability and
/// reservations attach to this model in later slices — none of them are
/// modelled yet.
model RoomType {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  name        String
  /// Short operational code ("DLXK"). Optional: the backfill has only the
  /// legacy free-text name to work from and must not invent one.
  code        String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([propertyId, name])
  @@unique([propertyId, code])
  @@index([propertyId])
  @@map("room_types")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// A bookable unit (room) within a Property. This models the room's
/// operational status only — booking/occupancy state is a future module.
model Room {
  id         String     @id @default(uuid())
  propertyId String     @map("property_id")
  name       String
  /// The room's category, drawn from this property's RoomType catalogue.
  /// Required: a room is always a bookable unit of some sellable type —
  /// the model Mews/Cloudbeds/Stayntouch all use — and rates and
  /// availability attach to the type, so an untyped room could never be
  /// sold. The legacy free-text `room_type` column this replaced was
  /// backfilled into `room_types` and dropped in migration
  /// `20260902000200_rooms_catalogue_only`.
  roomTypeId String     @map("room_type_id")
  floor      String?
  capacity   Int        @default(1)
  status     RoomStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: `roomTypeId` is now required, so a type still
  /// assigned to rooms must not be deletable out from under them. This is
  /// the database backstop for the 409 the room-types service already
  /// returns proactively (see `modules/room-types/service.ts`).
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@unique([propertyId, name])
  @@index([propertyId])
  @@index([roomTypeId])
  @@map("rooms")
}
