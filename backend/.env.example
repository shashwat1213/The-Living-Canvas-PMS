NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma.
# Matches the credentials in the root docker-compose.yml for local dev.
DATABASE_URL="postgresql://living_canvas:***@localhost:5432/living_canvas_pms?schema=public"

# Origin the frontend dev server runs on — used for the CORS allowlist and
# for deciding the refresh-token cookie's SameSite/Secure behavior.
FRONTEND_URL=http://localhost:5173

# Secret used to sign JWT access tokens. Generate a real one for anything
# beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value

# Access token lifetime (minutes) and refresh-session lifetime (days).
# See DECISIONS.md — JWT access token + DB-backed refresh session.
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# How long the token-revocation watermark (User.tokensValidAfter) is
# trusted from cache before re-checking the database — the actual bound
# on how fast a deactivation is enforced against an already-issued access
# token. See DECISIONS.md, "token-revocation watermark".
TOKENS_VALID_AFTER_CACHE_TTL_SECONDS=30

# Groq LLM API key for AI content generation (Marketing Studio) + the AI
# assistant. Free key, no credit card: https://console.groq.com/keys
# Without it the deterministic stub provider stays active, so the whole
# generate -> review -> approve pipeline still runs in dev/CI at no cost.
GROQ_API_KEY=
# Optional model override; defaults to qwen/qwen3.8-27b when unset.
GROQ_MODEL=qwen/qwen3.8-27b

# Marketing Studio media library (photos/videos) on S3.
# Unset MEDIA_S3_BUCKET = in-memory stub storage (dev/tests only; uploads are
# refused in production). Never put AWS access keys here:
#  - local dev: run `aws login --profile ams` and set AWS_PROFILE=ams
#  - Vercel: MEDIA_S3_ROLE_ARN (OIDC role, set by scripts/aws/setup-s3-media-bucket.sh)
# MEDIA_S3_BUCKET=livingcanvas2026
# MEDIA_S3_REGION=ap-south-1
# AWS_PROFILE=ams
# MEDIA_S3_ROLE_ARN=
# MinIO / S3-compatible only (docker-compose): MEDIA_S3_ENDPOINT,
# MEDIA_S3_PUBLIC_ENDPOINT, MEDIA_S3_FORCE_PATH_STYLE=true,
# MEDIA_S3_ACCESS_KEY_ID, MEDIA_S3_SECRET_ACCESS_KEY (local MinIO user).
